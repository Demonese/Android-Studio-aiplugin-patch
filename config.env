# aiplugin-patch 配置文件（被 scripts/*.sh source）

# 项目目录（按本文件自身位置计算，保证路径无关）
_AIP_CONF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Android Studio 发行包 zip 的路径（包含 plugins/gemini/lib/aiplugin.jar 与 lib/*.jar）
# 默认位于项目目录下；可用环境变量 AS_ZIP 覆盖
AS_ZIP="${AS_ZIP:-$_AIP_CONF_DIR/Android Studio.zip}"

# 目标插件 jar 在 zip 内的相对路径
PLUGIN_JAR_IN_ZIP="Android Studio/plugins/gemini/lib/aiplugin.jar"

# 编译目标 Java 版本（aiplugin.jar 的 class 文件版本为 65 = Java 21）
JAVA_RELEASE=21

# 工具版本
CFR_VERSION=0.152
ASM_VERSION=9.7.1

# 平台 jar（用于编译 classpath，均从 AS_ZIP 的 lib/ 提取）
PLATFORM_JARS=(
  "intellij.platform.ide.jar"        # observable properties / ComboBox / PropertyOperationUtil
  "intellij.platform.ide.impl.jar"   # Kotlin UI DSL (Panel/Row/Cell/ComboBoxKt)
  "util-8.jar"                       # xmlb (Converter/OptionTag/XmlSerializer) / Disposable / JDOM
  "util.jar"
  "annotations.jar"
)
KOTLIN_STDLIB_IN_ZIP="Android Studio/plugins/Kotlin/kotlinc/lib/kotlin-stdlib.jar"
